# Database
POSTGRES_USER=freightpulse
POSTGRES_PASSWORD=freightpulse_pass
POSTGRES_DB=freightpulse_db
DATABASE_URL=postgresql+asyncpg://freightpulse:freightpulse_pass@postgres:5432/freightpulse_db

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_KEY=your_internal_api_key_here

# External APIs
VESSELFINDER_API_KEY=your_vesselfinder_key_here

# Azure OpenAI (gpt-5-mini production deployment)
# Accepts resource root (https://<resource>.openai.azure.com/) or full /openai/v1 endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini-1
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AI_MODEL=gpt-5-mini

# Optional legacy/local Celery configuration
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
